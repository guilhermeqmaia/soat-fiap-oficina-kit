{
  "name": "@guilhermeqmaia/oficina-kit",
  "version": "0.1.0",
  "description": "Kit compartilhado dos microsservicos da Oficina Mecanica (Tech Challenge FIAP, Fase 4): auth resource server, logs JSON com correlacao, metricas, health, mensageria.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermeqmaia/soat-fiap-oficina-kit.git"
  },
  "homepage": "https://github.com/guilhermeqmaia/soat-fiap-oficina-kit#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "default": "./dist/health/index.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "default": "./dist/messaging/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:cov": "jest --coverage",
    "pack:smoke": "npm run build && npm pack --pack-destination /tmp && node scripts/smoke-install.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/swagger": "^11.2.7",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "dd-trace": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/testing": "^11.1.17",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "supertest": "^7.2.2",
    "express": "^5.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.2"
  }
}
