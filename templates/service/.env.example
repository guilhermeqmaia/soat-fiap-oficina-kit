# Banco proprio deste servico (RFC-0004: nenhum servico acessa o banco de outro)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/__DB_NAME__?schema=public"
# TLS no banco (RDS exige): true no EKS, vazio localmente
DB_SSL=
PORT=__PORT__
# Segredo HS256 compartilhado com a Lambda de autenticacao (Secrets Manager em producao).
# Tambem assina o JWT de servico das chamadas entre servicos (role SERVICO).
JWT_SECRET=change-me-to-a-strong-random-secret
# JWT_ISSUER=oficina-auth-lambda
LOG_LEVEL=debug

# Comunicacao HTTP entre os servicos (RFC-0008, docs/contratos/http-interno.md no hub).
# Vazio => localhost nas portas convencionadas (3000 OS, 3001 Billing, 3002 Execucao);
# no cluster o ConfigMap aponta para o DNS interno (http://billing-service:3001 ...).
OS_SERVICE_URL=http://localhost:3000
BILLING_SERVICE_URL=http://localhost:3001
EXECUCAO_SERVICE_URL=http://localhost:3002
# Timeout por tentativa e tentativas do ClienteHttpInterno (defaults do kit: 5000 / 3)
# HTTP_INTERNO_TIMEOUT_MS=5000
# HTTP_INTERNO_TENTATIVAS=3

# APM (opcional)
DD_TRACE_ENABLED=false
DD_SERVICE=__SERVICE_NAME__
