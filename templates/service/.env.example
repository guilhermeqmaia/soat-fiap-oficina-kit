# Banco proprio deste servico (RFC-0004: nenhum servico acessa o banco de outro)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/__DB_NAME__?schema=public"
# TLS no banco (RDS exige): true no EKS, vazio localmente
DB_SSL=
PORT=__PORT__
# Segredo HS256 compartilhado com a Lambda de autenticacao (Secrets Manager em producao)
JWT_SECRET=change-me-to-a-strong-random-secret
# JWT_ISSUER=oficina-auth-lambda
LOG_LEVEL=debug

# Mensageria (RFC-0006). SNS_TOPIC_ARN vazio => sobe sem broker (so eventos in-process).
# Local: `npm run docker:up` sobe LocalStack e cria a topologia (script do kit).
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-__SERVICE__.fifo
SQS_QUEUE_URL=http://localhost:4566/000000000000/__SERVICE__-comandos.fifo

# APM (opcional)
DD_TRACE_ENABLED=false
DD_SERVICE=__SERVICE_NAME__
