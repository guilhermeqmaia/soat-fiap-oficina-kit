// Banco PROPRIO deste servico (RFC-0004). Comece pelo modelo de infraestrutura
// abaixo (dedup de callbacks) e adicione os agregados do dominio em seguida.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Deduplicacao de callbacks/webhooks recebidos (comunicacao HTTP interna, RFC-0008):
/// `id` do envelope ja aplicado. Repeticao devolve `200 { aplicado: false, duplicado: true }`.
model ProcessedMessage {
  id           String   @id
  type         String
  processadaEm DateTime @default(now()) @map("processada_em")

  @@index([processadaEm])
  @@map("processed_messages")
}
